rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (default-deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Authentication & Identity Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation for Initial User Creation (Client can only initialize with 0 XP)
    function isValidInitialUser(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'avatar', 'xp'])
        && data.uid == userId
        && data.email is string && data.email.size() <= 256
        && data.fullName is string && data.fullName.size() <= 128
        && data.avatar is string && data.avatar.size() <= 256
        && data.xp == 0; // Strict: initial XP must be 0
    }

    // Validation for User Profile Updates:
    // Client can ONLY update safe profile fields (fullName, avatar, preferences, language).
    // Sensitive server-controlled fields (xp, uid, email, literacyLevel, rank, badges) CANNOT be changed by client.
    function isSafeProfileUpdate(incoming, existing) {
      return incoming.uid == existing.uid
        && incoming.email == existing.email
        && incoming.xp == existing.xp // FORBIDDEN: Client cannot inflate XP
        && (!('literacyLevel' in existing) || incoming.literacyLevel == existing.literacyLevel)
        && incoming.fullName is string && incoming.fullName.size() <= 128
        && incoming.avatar is string && incoming.avatar.size() <= 256;
    }

    // Validation for Chat History
    function isValidChat(data) {
      return data.keys().hasAll(['userId', 'question', 'response', 'createdAt'])
        && data.userId == request.auth.uid
        && data.question is string && data.question.size() <= 2048
        && data.response is string && data.response.size() <= 65536
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Validation for Investment Transactions (Strict Integrity)
    function isValidInvestment(data) {
      return data.keys().hasAll(['userId', 'symbol', 'type', 'shares', 'price', 'total', 'createdAt'])
        && data.userId == request.auth.uid
        && data.symbol is string && data.symbol.size() <= 32
        && (data.type == 'BELI' || data.type == 'JUAL' || data.type == 'BONUS' || data.type == 'DEVIDEN')
        && data.shares is number && data.shares > 0 // Strict: shares must be strictly positive
        && data.price is number && data.price >= 0 // Strict: price cannot be negative
        && data.total is number && data.total >= 0 // Strict: total cannot be negative
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Validation for Learning Progress
    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'moduleId', 'status', 'completedAt'])
        && data.userId == request.auth.uid
        && data.moduleId is string && data.moduleId.size() <= 64
        && data.status is string && data.status.size() <= 64
        && data.completedAt is string && data.completedAt.size() <= 64;
    }

    // --- COLLECTION RULES ---

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidInitialUser(request.resource.data, userId);
      allow update: if isOwner(userId) && isSafeProfileUpdate(request.resource.data, resource.data);
      allow delete: if false; // User documents are permanent
    }

    // 2. Chat History (Immutable after creation)
    match /chatHistory/{chatId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidChat(request.resource.data);
      allow update, delete: if false;
    }

    // 3. Investment History Ledger (Immutable after creation)
    match /investmentHistory/{historyId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidInvestment(request.resource.data);
      allow update, delete: if false;
    }

    // 4. Learning Progress
    match /learningProgress/{progressId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && isValidProgress(request.resource.data);
      allow delete: if false;
    }
  }
}
