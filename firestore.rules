rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (default-deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for User profiles
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'xp', 'fullName', 'avatar', 'literacyLevel'])
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.xp is number
        && data.fullName is string && data.fullName.size() <= 128
        && data.avatar is string && data.avatar.size() <= 256
        && data.literacyLevel is string && data.literacyLevel.size() <= 64;
    }

    // Validation for Chat History
    function isValidChat(data) {
      return data.keys().hasAll(['userId', 'question', 'response', 'mood', 'createdAt'])
        && data.userId == request.auth.uid
        && data.question is string && data.question.size() <= 2048
        && data.response is string && data.response.size() <= 65536
        && data.mood is string && data.mood.size() <= 64
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Validation for Investment transactions
    function isValidInvestment(data) {
      return data.keys().hasAll(['userId', 'symbol', 'type', 'shares', 'price', 'total', 'createdAt'])
        && data.userId == request.auth.uid
        && data.symbol is string && data.symbol.size() <= 32
        && (data.type == 'BELI' || data.type == 'JUAL' || data.type == 'BONUS' || data.type == 'DEVIDEN')
        && data.shares is number
        && data.price is number
        && data.total is number
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // Validation for Classroom learning progress
    function isValidProgress(data) {
      return data.keys().hasAll(['userId', 'moduleId', 'status', 'completedAt'])
        && data.userId == request.auth.uid
        && data.moduleId is string && data.moduleId.size() <= 64
        && data.status is string && data.status.size() <= 64
        && data.completedAt is string && data.completedAt.size() <= 64;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false; // Profiles are never deleted on-client
    }

    match /chatHistory/{chatId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidChat(request.resource.data);
      allow update, delete: if false;
    }

    match /investmentHistory/{historyId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidInvestment(request.resource.data);
      allow update, delete: if false;
    }

    match /learningProgress/{progressId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && isValidProgress(request.resource.data);
      allow delete: if false;
    }
  }
}
